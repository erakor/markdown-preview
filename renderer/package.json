{
  "name": "markdown-preview-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown + Mermaid renderer bundle loaded by the macOS app's WKWebView",
  "scripts": {
    "build": "node build.mjs",
    "lint": "oxlint --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@erakor/toolchain": "github:erakor/toolchain#f1b5fee4e8d1d7a3df29460710db1808f5523d6f",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  }
}
